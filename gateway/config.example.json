{
  "listen": "127.0.0.1:7863",
  "api_key": "your-api-key-here",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "region": "auto",
  "product": "cli",
  "sticky_session": true,
  "frame_extractor": "",
  "frame_count": 0,
  "frame_max_size": 768,
  "frame_quality": 80,
  "video_asr": true,
  "audio_mode": "hybrid",
  "audio_quality": "fine",
  "cooldown": {
    "hard_credit": "12h",
    "hard_reset_hour": 4,
    "soft_rate": "10m",
    "soft_rate_max": "1h",
    "err_threshold": 5,
    "err_cooldown": "10m"
  },
  "schedule": {
    "checkin_hours": [9, 21],
    "keepalive_hours": [22]
  },
  "upstream": {
    "timeout_seconds": 120
  }
}
